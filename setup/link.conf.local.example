# ============================================================================
# setup/link.conf.local.example
#
# Copy to setup/link.conf.local (gitignored) to override link.conf values for
# this host only.
#
# Excluded: WIFI_CHANNEL, BANDWIDTH, MCS_INDEX, STBC, LDPC, SHORT_GI,
# LINK_DOMAIN, WIFI_REGION. install.sh warns if link.conf.local overrides one
# of these and prints a fingerprint of their combined value to compare
# between hosts.
# ============================================================================

# POWER_SOURCE=external
# WIFI_TXPOWER=1500

# QGC_HOST=192.168.1.50
