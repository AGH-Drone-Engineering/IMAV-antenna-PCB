# =============================================================================
# GENERATED by setup/lib/50-config.sh from setup/link.conf. DO NOT EDIT HERE.
# Appended after wifibroadcast.common.cfg.in. Air-unit-only overrides.
# =============================================================================

[drone]
link_domain = "${LINK_DOMAIN}"

[drone_mavlink]
# AIR_MAVLINK_PEER is computed by 50-config.sh: either a native serial
# transport (wfb-ng opens MAVLINK_SERIAL directly, no mavlink-routerd/socat
# needed) or a UDP listener, depending on whether MAVLINK_UDP_PORT is set.
peer = '${AIR_MAVLINK_PEER}'

[drone_tunnel]
ifaddr = '${TUNNEL_IP_AIR}/${TUNNEL_PREFIX}'
