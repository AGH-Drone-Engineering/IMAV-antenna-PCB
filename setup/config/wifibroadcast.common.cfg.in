# =============================================================================
# GENERATED by setup/lib/50-config.sh from setup/link.conf. DO NOT EDIT HERE.
# To change these values: edit setup/link.conf, then run:
#   sudo ./install.sh --role air|gs --only 50-config
#   sudo systemctl restart wifibroadcast@drone   # or wifibroadcast@gs
#
# wfb-ng loads config in four layers, in order: master.cfg (package
# defaults) -> site.cfg (build metadata, don't touch) ->
# /etc/wifibroadcast.cfg (this file + the role-specific file appended after
# it) -> local.cfg (debug only). Only the deltas we actually care about are
# set here -- everything else falls back to wfb-ng's own master.cfg default.
#
# IMPORTANT: this repo tracks wfb-ng's rolling 'master' apt component (see
# VERSIONS) because Trixie has no working stable channel. That means
# upstream's own defaults can drift under us. Never rely on an upstream
# default silently matching what we want -- if a value matters, it is set
# explicitly below, not left implicit.
#
# ⚠ Every value in this file must be IDENTICAL on both the air and gs ends.
# =============================================================================

[common]
wifi_channel = ${WIFI_CHANNEL}
wifi_region = '${WIFI_REGION}'
wifi_txpower = ${WIFI_TXPOWER}

[base]
bandwidth = ${BANDWIDTH}
mcs_index = ${MCS_INDEX}
stbc = ${STBC}
ldpc = ${LDPC}
short_gi = ${SHORT_GI}

[mavlink]
inject_rssi = True
mavlink_sys_id = ${MAVLINK_SYS_ID}
fec_k = ${FEC_MAVLINK_K}
fec_n = ${FEC_MAVLINK_N}
fec_timeout = ${FEC_MAVLINK_TIMEOUT}

[tunnel]
fec_k = ${FEC_TUNNEL_K}
fec_n = ${FEC_TUNNEL_N}
fec_timeout = ${FEC_TUNNEL_TIMEOUT}

# Phase 2 (video). Not part of the MVP -- no camera source is wired up yet --
# but the radio-side stream already exists unconditionally in wfb-ng's own
# [drone]/[gs] profiles (stream 0x00), so setting its FEC here now costs
# nothing and saves a step later. See docs/integration.md for how a camera
# eventually plugs into udp://127.0.0.1:5602 (air) / :5600 (gs).
[video]
fec_k = ${FEC_VIDEO_K}
fec_n = ${FEC_VIDEO_N}
