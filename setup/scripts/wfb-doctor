#!/usr/bin/env bash
# setup/scripts/wfb-doctor — one-shot diagnostic dump. Run this first when
# something isn't working; it's the checklist from docs/troubleshooting.md
# turned into a single command. Safe to run without root (some checks will
# just report "skipped, need root").
set -uo pipefail

section() { printf '\n\033[1m== %s ==\033[0m\n' "$1"; }

section "USB enumeration (expect 0bda:a81a)"
if command -v lsusb >/dev/null 2>&1; then
    lsusb | grep -i '0bda' || echo "No Realtek (0bda:*) USB device found -- module not plugged in, or not powered."
else
    echo "lsusb not installed"
fi

section "Kernel driver binding"
nic="$(wfb-nics 2>/dev/null | head -1)"
if [ -n "$nic" ]; then
    echo "wfb-nics reports: $nic"
    if command -v ethtool >/dev/null 2>&1; then
        ethtool -i "$nic" 2>/dev/null | grep -E 'driver|version' || echo "ethtool -i $nic failed"
    fi
    ip -brief link show "$nic" 2>/dev/null
else
    echo "wfb-nics found no interface. Expected driver name: rtl88x2eu."
    echo "Check: dmesg | grep -i 8812eu   and   dkms status"
fi

section "DKMS status"
if command -v dkms >/dev/null 2>&1; then
    dkms status 2>/dev/null | grep -i 'rtl88x2eu\|realtek-rtl88x2eu' || echo "No matching DKMS module registered."
else
    echo "dkms not installed"
fi

section "wfb-ng package"
if command -v dpkg >/dev/null 2>&1; then
    dpkg -l wfb-ng 2>/dev/null | tail -1
    echo -n "wfb_tun present in package: "
    dpkg -L wfb-ng 2>/dev/null | grep -q 'wfb_tun$' && echo "yes" || echo "NO -- tunnel/SSH will not work, see docs/troubleshooting.md"
fi

section "systemd services"
for svc in wifibroadcast@drone wifibroadcast@gs; do
    state="$(systemctl is-active "$svc" 2>/dev/null || true)"
    echo "$svc: ${state:-not found}"
done

section "Tunnel interfaces (drone-wfb / gs-wfb)"
ip -brief addr show 2>/dev/null | grep -E 'drone-wfb|gs-wfb' || echo "Neither tunnel interface is up."

section "Video (phase 2)"
if [ -f /usr/local/bin/wfb-video-air ]; then
    echo "Generated pipeline script: present (/usr/local/bin/wfb-video-air)"
else
    echo "Generated pipeline script: not present (VIDEO_ENABLE=0, or 90-video hasn't run on the air role)"
fi
air_state="$(systemctl is-active wfb-video-air.service 2>/dev/null || true)"
echo "wfb-video-air.service: ${air_state:-not found}"
for codec in h264 h265; do
    state="$(systemctl is-active "rtsp@${codec}.service" 2>/dev/null || true)"
    [ -n "$state" ] && echo "rtsp@${codec}.service: $state"
done
echo "Video streams (udp 5602 air-side listen, 5600 gs-side forward) carry no"
echo "counters of their own outside wfb-cli -- check wfb-cli's video pane for"
echo "non-zero traffic, and watch for 'trunc' (payload over radio_mtu)."

section "Link config fingerprint"
if [ -f /etc/wifibroadcast.cfg ]; then
    echo "sha256 of /etc/wifibroadcast.cfg: $(sha256sum /etc/wifibroadcast.cfg | cut -c1-16)"
    echo "(compare the radio-section fingerprint printed by install.sh on both ends instead --"
    echo " this one includes role-specific values too, so it will differ between air and gs.)"
else
    echo "/etc/wifibroadcast.cfg not found -- run install.sh first."
fi

section "Next steps"
echo "Live stats: wfb-cli drone   (or: wfb-cli gs)"
echo "Full logs:  journalctl -u wifibroadcast@drone -e --no-pager   (or @gs)"
echo "See docs/troubleshooting.md for symptom -> cause -> command."
